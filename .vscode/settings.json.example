{
    // ── CMake Tools / Telink Extension configuration ──────────────────────────
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/cmake_builds/ATC_Thermometer/TC32-GCC_Toolchain",
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/cmake/tc32-toolchain.cmake",
        "CMAKE_MAKE_PROGRAM": "${env:USERPROFILE}/.Telink_Tools/ninja_tlk/ninja.exe"
    },
    "cmake.generator": "Ninja",
    "tlk.cmake_generator": "Ninja",
    "tlk.workProjectName": "ATC_Thermometer",
    "tlk.workTargetName": "ATC",
    // ── VsCodeTaskButtons ─────────────────────────────────────────────────────
    "VsCodeTaskButtons.tasks": [
        {
            "label": "$(notebook-move-down) Build",
            "task": "Build",
            "tooltip": "🛠️ Start a \"Build\" action"
        },
        {
            "label": "$(search-refresh) Re-Build",
            "task": "Re-Build",
            "tooltip": "🧹🛠️ Start a \"Clean & Re-Build\" action"
        },
        {
            "label": "$(notebook-delete-cell) Clean build",
            "task": "Clean",
            "tooltip": "🧹 Start a \"clean\" action"
        }
    ]
}
